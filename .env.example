# ---------------------------------------------------------------------------
# VXthenics — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for admin tasks / cron jobs. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key (hex) used to encrypt third-party API tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# AI coach — Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Strava OAuth (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Google OAuth — for Google Fit (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — weekly review emails (https://resend.com/api-keys)
RESEND_API_KEY=
# Optional sender. Defaults to onboarding@resend.dev (works to your own email
# in Resend test mode). Use a verified domain to send to anyone.
EMAIL_FROM=

# Protects cron endpoints. Generate any random string.
CRON_SECRET=
